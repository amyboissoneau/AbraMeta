# Copy this file to .env and fill in your real values.

# --- Dashboard address (optional; leave blank for the defaults) ---
# The port the dashboard listens on. Default 8765: open http://localhost:8765 in Chrome.
# You can also set it on the command line: ABRA_PORT=9000 python3 liveview.py
ABRA_PORT=
# The HTTPS port for the phone link on your Wi-Fi. Default 8766.
ABRA_HTTPS_PORT=
# If you change ABRA_PORT, add http://localhost:<your port>/oauth/callback as a Valid OAuth Redirect URI
# in your Facebook app, or Facebook sign-in will not return to Abra.

# --- Your identity and pages (all optional; blank = neutral wording, no name) ---
# Your name, as it should appear in AI prompts and the page title. Blank = no name.
CREATOR_NAME=
# Optional facts for brand-pitch drafts. Only what you write here is used; nothing is invented.
CREATOR_BIO=
# Optional: your own contract standards, used when reviewing brand deals.
CREATOR_TERMS=
# Display names of your two Facebook pages (used by the two-page posting plan).
PRIMARY_PAGE_NAME=
SECOND_PAGE_NAME=
# Your Facebook app's ID and App Secret (developers.facebook.com). Needed to connect Facebook
# and to run setup_token.py and add_page.py. Keep the secret private.
FB_APP_ID=
FB_APP_SECRET=
# macOS launchd service label prefix, only if you run Abra as launchd services (see watchdog.py).
LAUNCHD_PREFIX=

# --- Facebook (Meta) ---
# Your Facebook Page ID (found in Page settings, or via the Graph API Explorer)
FB_PAGE_ID=

# A long-lived PAGE access token. For the full Content Scheduler (publishing and
# scheduling Reels/Stories) it also needs: pages_manage_posts.
# Core engagement needs: pages_show_list, pages_read_engagement,
#   pages_read_user_content, pages_manage_engagement
# See README.md for step-by-step instructions on generating this.
FB_PAGE_ACCESS_TOKEN=

# Graph API version to use
FB_API_VERSION=v23.0

# --- Meta Model API (Muse) ---
# Powers Muse Spark (triage + copywriting), Muse Image (Story FX overlays)
# and Muse Voice Transcribe (hearing your videos). Get a key at dev.meta.ai.
META_MUSE_API_KEY=

# --- Anthropic (Claude) ---
# Get an API key at https://platform.claude.com
ANTHROPIC_API_KEY=

# --- ElevenLabs (optional) — studio voices for the Abra concierge / crew ---
# Not required: the crew already speak in free neural voices (Microsoft edge-tts).
# Add a key only to upgrade to ElevenLabs studio voices. https://elevenlabs.io
ELEVENLABS_API_KEY=
# Optional: override the voice IDs per crew member (defaults are British/warm/deep/confident)
# ELEVEN_VOICE_MUSE=
# ELEVEN_VOICE_CLAUDE=
# ELEVEN_VOICE_KOA=

# --- Bot behavior ---
# Seconds between polling cycles
POLL_INTERVAL_SECONDS=60

# How many recent posts to watch for new comments
POSTS_TO_MONITOR=25

# Ignore comments older than this many hours (prevents replying to ancient
# comments the first time you run the bot). Set to 0 to disable the age check.
MAX_COMMENT_AGE_HOURS=48

# Replies per 15-minute window (default 30; surge mode can raise it to 60)
MAX_REPLIES_PER_WINDOW=30

# true = comment replies, likes and first comments are only printed. DM auto-replies (default dm_mode=auto) and queued Stories still post.
# ALWAYS start with dry run to check the bot's tone before going live.
DRY_RUN=true

# --- Meta OPEN-WEIGHT model (optional) — for the $10K "Best Build on Open-Weight" prize ---
# Routes comment triage through a Meta open-weight model via the hackathon inference partners.
# Set one — or several — and it runs as a resilient fallback chain (first that answers wins).
# All are OpenAI-compatible; see muse_open.py:
#   Baseten (recommended — serves Meta's "Muse Spark Open"):
BASETEN_API_KEY=
#   Fireworks (serves Meta's Llama open weights):
FIREWORKS_API_KEY=
#   Modal (deploy your own OpenAI endpoint, then set its URL):
MODAL_API_KEY=
MODAL_BASE_URL=
# Optional: force a provider, else the first key present (baseten > fireworks > modal) is used.
# OPENWEIGHT_PROVIDER=baseten
# Optional model overrides: BASETEN_MODEL / FIREWORKS_MODEL / MODAL_MODEL

# Demo recording only: true makes Approve & schedule dry-run (nothing goes to Facebook). Leave blank otherwise.
ABRA_DEMO_DRY_RUN=
